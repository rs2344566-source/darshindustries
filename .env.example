# Copy this file to .env and fill in the values. Never upload .env publicly.
PORT=3000
NODE_ENV=development
# MongoDB Atlas connection string. Keep the password private.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=darshindustries
# Admin login for html/admin.html — use a long, unique password.
ADMIN_EMAIL=roshan932145@gmail.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
# Email settings are optional until you configure an SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=roshan932145@gmail.com
